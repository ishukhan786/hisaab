{
  "name": "hisaab",
  "productName": "حساب",
  "version": "1.2.1",
  "description": "حساب — آف لائن روزانہ کھاتہ، اندراج رجسٹر اور پرنٹ سسٹم",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "accounting",
    "khata",
    "hisaab",
    "urdu",
    "offline",
    "ledger"
  ],
  "author": "ishukhan786",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ishukhan.hisaab",
    "productName": "حساب",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "حساب",
      "artifactName": "Hisaab-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Hisaab-Portable-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "app.js",
      "excel-export.js",
      "assets/**/*",
      "guide.html",
      "receipt-image.html",
      "ui.css",
      "ui.js",
      "journal.js",
      "journal.css"
    ]
  }
}
