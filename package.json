{
  "name": "hisaab",
  "productName": "حساب",
  "version": "1.4.11",
  "description": "حساب — آف لائن روزانہ کھاتہ، اندراج رجسٹر اور پرنٹ سسٹم",
  "main": "main.js",
  "scripts": {
    "test": "node scripts/test-runner.cjs",
    "start": "electron .",
    "serve": "node server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "signing:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-signed.ps1 -CheckOnly",
    "dist:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-signed.ps1"
  },
  "keywords": [
    "accounting",
    "khata",
    "hisaab",
    "urdu",
    "offline",
    "ledger"
  ],
  "author": "ishukhan786",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "html2canvas": "^1.4.1"
  },
  "build": {
    "appId": "com.ishukhan.hisaab",
    "productName": "حساب",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "حساب",
      "artifactName": "Hisaab-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Hisaab-Portable-${version}.exe"
    },
    "files": [
      "main.js",
      "database.js",
      "preload.js",
      "index.html",
      "style.css",
      "app.js",
      "excel-export.js",
      "assets/**/*",
      "guide.html",
      "receipt-image.html",
      "ui.css",
      "ui.js",
      "journal.js",
      "journal.css",
      "receipt-png.js",
      "receipt-export.css",
      "external-backup.cjs",
      "external-backup-ui.js"
    ]
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mongoose": "^9.11.2"
  }
}
