# MongoDB connection string (Required)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/hisaab?retryWrites=true&w=majority

# Port for local web server (Default: 3000)
PORT=3000

# Session signing secret. Required in production (minimum 16 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HISAAB_AUTH_SECRET=change-this-to-a-long-random-secret

# Optional: comma-separated origins allowed to call the API cross-origin in production.
# Same-origin requests never need this. Leave unset to block all cross-origin access.
# HISAAB_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Owner credentials (never keep the defaults in production)
HISAAB_USERNAME=admin
HISAAB_PASSWORD=change-this-password
