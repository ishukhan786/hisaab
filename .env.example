# MongoDB connection string (Required)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/hisaab?retryWrites=true&w=majority

# Port for local web server (Default: 3000)
PORT=3000

# Production JWT Secret: Must be at least 16 characters long.
# Required in production environments (e.g. Vercel, VPS).
JWT_SECRET=your_super_secret_random_key_min_16_chars_here

# Optional: Initial Admin PIN / Password override
# If omitted in production, first-time PIN setup will be prompted in the web interface.
# APP_PIN=1234
